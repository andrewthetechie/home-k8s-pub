        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(tensorfold:spill_written_bytes{job=\"engine-tensorfold\"}[$__rate_interval])",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "written B/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(tensorfold:spill_read_bytes{job=\"engine-tensorfold\"}[$__rate_interval])",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "read B/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(tensorfold:spill_writes_committed{job=\"engine-tensorfold\"}[$__rate_interval])",
          "refId": "C",
          "instant": false,
          "range": true,
          "legendFormat": "writes committed/s"
        }
      ]
    },
    {
