        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "tensorfold:spill_cap_bytes{job=\"engine-tensorfold\"}",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "rank {{rank}} cap"
