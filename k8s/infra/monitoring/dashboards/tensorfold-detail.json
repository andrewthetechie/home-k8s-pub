    {
      "id": 7,
      "type": "timeseries",
      "title": "Request latencies",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(tensorfold:request_latency_seconds_bucket{job=\"engine-tensorfold\"}[5m])))",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "latency p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tensorfold:request_latency_seconds_bucket{job=\"engine-tensorfold\"}[5m])))",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "latency p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(tensorfold:request_decode_seconds_bucket{job=\"engine-tensorfold\"}[5m])))",
          "refId": "C",
          "instant": false,
          "range": true,
          "legendFormat": "decode p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(tensorfold:request_prefill_seconds_bucket{job=\"engine-tensorfold\"}[5m])))",
          "refId": "D",
          "instant": false,
          "range": true,
          "legendFormat": "prefill p50"
        }
      ],
      "description": "Finished requests only, so 5m windows: a long request lands in one step."
    },
