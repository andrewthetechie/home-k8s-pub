        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "tensorfold:spill_disk_free_bytes{job=\"engine-tensorfold\"}",
          "refId": "C",
          "instant": false,
          "range": true,
          "legendFormat": "rank {{rank}} disk free"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "tensorfold:spill_staging_bytes{job=\"engine-tensorfold\"}",
          "refId": "D",
          "instant": false,
          "range": true,
          "legendFormat": "rank {{rank}} staging"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Spill I/O",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
