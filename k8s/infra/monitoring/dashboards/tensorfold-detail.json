{
  "uid": "tensorfold-detail",
  "title": "tensorfold detail",
  "tags": [
    "inference",
    "tensorfold"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "box",
        "label": "box",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "query": {
          "qryType": 1,
          "refId": "StandardVariableQuery",
          "query": "label_values(inference:generated_tokens_total, box)"
        }
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "query": {
          "qryType": 1,
          "refId": "StandardVariableQuery",
          "query": "label_values(up{job=\"node\", box=~\"$box\"}, node)"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Engine restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "resets(inference:generated_tokens_total[1m]) > 0",
          "refId": "Anno",
          "instant": true
        },
        "titleFormat": "engine restart",
        "textFormat": "{{box}} {{node}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rank pair state",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "tensorfold:pair_broken{job=\"engine-tensorfold\"}",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "broken"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "tensorfold:pair_stalled{job=\"engine-tensorfold\"}",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "stalled"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "tensorfold:pair_stall_ms{job=\"engine-tensorfold\"}",
          "refId": "C",
          "instant": false,
          "range": true,
          "legendFormat": "stall ms"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "tensorfold:pair_busy_ms{job=\"engine-tensorfold\"}",
          "refId": "D",
          "instant": false,
          "range": true,
          "legendFormat": "busy ms"
        }
      ],
      "description": "broken/stalled are 0/1 gauges; the ms gauges are the engine thread's view."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spill: stored vs cap",
      "gridPos": {
        "h": 7,
        "w": 12,
