        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "strix_ple_wait_max_seconds{box=~\"$box\", node=~\"$node\"}",
          "refId": "B",
          "instant": false,
