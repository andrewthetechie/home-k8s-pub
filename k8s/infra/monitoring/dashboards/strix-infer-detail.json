          },
          "expr": "strix_prompt_cache_ram_bytes{box=~\"$box\", node=~\"$node\"}",
          "refId": "D",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} ram bytes"
        }
      ]
    },
    {
