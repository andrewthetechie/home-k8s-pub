{
  "uid": "strix-infer-detail",
  "title": "strix-infer detail",
  "tags": [
    "inference",
    "strix-infer"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "box",
        "label": "box",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "query": {
          "qryType": 1,
          "refId": "StandardVariableQuery",
          "query": "label_values(inference:generated_tokens_total, box)"
        }
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "query": {
          "qryType": 1,
          "refId": "StandardVariableQuery",
          "query": "label_values(up{job=\"node\", box=~\"$box\"}, node)"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Engine restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "resets(inference:generated_tokens_total[1m]) > 0",
          "refId": "Anno",
          "instant": true
        },
        "titleFormat": "engine restart",
        "textFormat": "{{box}} {{node}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "MTP acceptance and rollbacks",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "strix_mtp_acceptance_rate{box=~\"$box\", node=~\"$node\"}",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} acceptance"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(strix_mtp_rollbacks_total{box=~\"$box\", node=~\"$node\"}[$__rate_interval])",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} rollbacks/s"
        }
      ],
      "description": "strix_mtp_acceptance_rate is the gauge; rollbacks show drafts thrown away."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "MTP drafted vs accepted tokens",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(strix_mtp_drafted_tokens_total{box=~\"$box\", node=~\"$node\"}[$__rate_interval])",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} drafted/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(strix_mtp_accepted_tokens_total{box=~\"$box\", node=~\"$node\"}[$__rate_interval])",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} accepted/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Prompt-cache hits by tier",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
