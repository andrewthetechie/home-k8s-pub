            "uid": "victoriametrics"
          },
          "expr": "strix_kv_generation_capacity{box=~\"$box\", node=~\"$node\"}",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} capacity"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(strix_kv_renewals_total{box=~\"$box\", node=~\"$node\"}[$__rate_interval])",
