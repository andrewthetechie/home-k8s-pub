      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Engine's own decode rate vs the contract",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "strix_last_decode_tokens_per_second{box=~\"$box\", node=~\"$node\"}",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} last request"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "increase(inference:generated_tokens_total{box=~\"$box\", node=~\"$node\"}[5m]) / increase(inference:decode_seconds_total{box=~\"$box\", node=~\"$node\"}[5m])",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} token-weighted 5m"
        }
      ],
      "description": "If these agree, the per-request time accounting is behaving."
    },
    {
