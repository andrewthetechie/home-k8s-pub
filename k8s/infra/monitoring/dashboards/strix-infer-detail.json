            "uid": "victoriametrics"
          },
          "expr": "rate(strix_prompt_cache_point_hits_total{box=~\"$box\", node=~\"$node\"}[$__rate_interval])",
          "refId": "C",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} point/s"
        }
      ]
